# GDB global config — managed by stow (dotfiles/gdb).
#
# The LLVM worktrees are built with -ffile-prefix-map so debug info is
# directory-neutral (LLVM_USE_RELATIVE_PATHS_IN_FILES=ON,
# LLVM_SOURCE_PREFIX=/llvm-project/ in 01-llvm-project.sh). That lets ccache
# reuse a single .o across every worktree, but it also means the source and
# build paths baked into the binary read as:
#
#     /llvm-project/llvm/lib/.../Foo.cpp      (source)
#     /llvm-project/build/.../Foo.inc         (generated, in-tree build dir)
#
# instead of the real workspace/NN/llvm-project path. This hook rewrites that
# /llvm-project sentinel back to whichever worktree the loaded binary actually
# lives in, so `list`, breakpoints and stepping find the right files no matter
# which worktree — or which cwd — you debug from. One global file covers all
# worktrees; nothing per-worktree to maintain.
#
# Worktree root is detected from the binary's own path (the directory named
# "llvm-project"), so debugging workspace/07's opt maps /llvm-project ->
# .../workspace/07/llvm-project automatically.

python
import glob, json, os
import gdb

_development_root = "/raid/jinpli/workspace/home/jinpli/development"
_central_llvm = os.path.join(_development_root, "repos", "llvm-project")
_workspace_root = os.path.join(_development_root, "workspace")

def _gdb_quote(value):
    """Quote one GDB CLI argument and verify that it round-trips exactly."""
    if "\0" in value or "\n" in value or "\r" in value:
        raise ValueError("unsupported control character in GDB path")
    quoted = json.dumps(value)
    if gdb.string_to_argv(quoted) != [value]:
        raise ValueError("path cannot be represented as one GDB argument")
    return quoted

def _is_known_llvm_root(path):
    path = os.path.realpath(path)
    return (
        path == os.path.realpath(_central_llvm)
        or (
            os.path.basename(path) == "llvm-project"
            and os.path.dirname(os.path.dirname(path))
                == os.path.realpath(_workspace_root)
        )
    )

def _source_root_for_objfile(filename):
    path = os.path.realpath(filename)
    while path != "/":
        if os.path.isdir(path) and _is_known_llvm_root(path):
            return path
        # A sibling build can be <workspace>/<id>/build/llvm-project. Map its
        # debug sentinel to the corresponding source worktree instead.
        if (
            os.path.basename(path) == "llvm-project"
            and os.path.basename(os.path.dirname(path)) == "build"
        ):
            candidate = os.path.join(
                os.path.dirname(os.path.dirname(path)), "llvm-project"
            )
            if os.path.isdir(candidate) and _is_known_llvm_root(candidate):
                return os.path.realpath(candidate)
        path = os.path.dirname(path)
    return None

# Trust only LLVM's own auto-load scripts, not every checkout under development/.
_auto_load_roots = [_central_llvm]
_auto_load_roots.extend(
    glob.glob(os.path.join(_workspace_root, "*", "llvm-project"))
)
for _root in _auto_load_roots:
    _root = os.path.realpath(_root)
    if os.path.isdir(_root) and _is_known_llvm_root(_root):
        gdb.execute(
            "add-auto-load-safe-path " + _gdb_quote(_root), to_string=True
        )

def _llvm_substitute_path(event):
    objfile = getattr(event, "new_objfile", None)
    fname = getattr(objfile, "filename", None) if objfile else None
    if not fname:
        return
    p = _source_root_for_objfile(fname)
    if p is None:
        return
    try:
        source = _gdb_quote("/llvm-project")
        target = _gdb_quote(p)
    except ValueError:
        return
    # Re-point the build-time sentinel at this worktree. Drop any stale rule
    # first so loading a second worktree's binary in one session re-maps cleanly.
    try:
        gdb.execute("unset substitute-path " + source, to_string=True)
    except gdb.error:
        pass
    gdb.execute("set substitute-path " + source + " " + target, to_string=True)

gdb.events.new_objfile.connect(_llvm_substitute_path)
end
